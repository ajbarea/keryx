#!/usr/bin/env bash
# Runs keryx from this checkout. The venv lives outside the plugin cache so updates keep it, and
# is named for the plugin's version and location so one version never runs another's code.
set -euo pipefail
uv_install='curl -LsSf https://astral.sh/uv/install.sh | sh'
if ! command -v uv >/dev/null 2>&1; then
  # Hooks run async, so nobody sees their stderr; SessionStart gets a visible message instead.
  payload=""
  if [ "${1:-}" = hook ]; then
    IFS= read -r -d '' payload || true
    [[ "$payload" == *SessionStart* ]] \
      && printf '{"systemMessage": "keryx needs uv: %s"}\n' "$uv_install"
    exit 0
  fi
  printf 'keryx needs uv, which is not on PATH.\n  fix: %s\nOpen a new terminal, then run this command again.\n' "$uv_install" >&2
  exit 127
fi
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
base="${XDG_CACHE_HOME:-$HOME/.cache}/keryx"
version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$root/.claude-plugin/plugin.json" 2>/dev/null | head -n 1)"
where="$(printf '%s' "$root" | cksum | cut -d' ' -f1)"
name="venv-${version:-unknown}-$where"
export UV_PROJECT_ENVIRONMENT="$base/$name"
mkdir -p "$base"
printf '%s' "$root" >"$base/$name.root"
# A venv whose checkout is gone (an old plugin version, cleaned up after an update) is dead
# weight. Only a venv this script named, by its `.root` record, is ever removed.
for record in "$base"/venv-*.root; do
  [ -e "$record" ] || continue
  stale="${record%.root}"
  [ "$stale" = "$base/$name" ] && continue
  recorded="$(cat "$record" 2>/dev/null)" || continue
  { [ -z "$recorded" ] || [ -d "$recorded" ]; } && continue
  # Best effort: a venv that cannot be deleted must not stop keryx from running.
  [ -L "$stale" ] || rm -rf -- "$stale" 2>/dev/null || continue
  rm -f -- "$record" 2>/dev/null || true
done
extra=()
# With an NVIDIA GPU, pull the CUDA runtime wheels so Kokoro runs on it.
if command -v nvidia-smi >/dev/null 2>&1; then extra=(--extra cuda); fi
exec uv run --quiet --frozen --no-dev "${extra[@]}" --project "$root" python -m keryx "$@"
